{
  "name": "riendzo-admin-dashboard",
  "version": "1.0.0",
  "description": "Admin dashboard for Riendo travel social app",
  "main": "index.html",
  "scripts": {
    "start": "npx serve . -l 3000",
    "dev": "npx serve . -l 3000 -o",
    "build": "npm run build:css && npm run build:js",
    "build:css": "postcss src/css/main.css -o dist/css/main.css",
    "build:js": "webpack --mode production",
    "watch": "npm run watch:css & npm run watch:js",
    "watch:css": "postcss src/css/main.css -o dist/css/main.css --watch",
    "watch:js": "webpack --mode development --watch",
    "lint": "eslint src/js/**/*.js",
    "lint:fix": "eslint src/js/**/*.js --fix",
    "format": "prettier --write src/**/*.{js,css,html}",
    "test": "jest",
    "deploy": "npm run build && firebase deploy"
  },
  "keywords": [
    "admin",
    "dashboard",
    "travel",
    "social",
    "riendzo",
    "firebase",
    "javascript"
  ],
  "author": "Riendo Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "autoprefixer": "^10.4.0",
    "cssnano": "^6.0.0",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^10.1.0",
    "prettier": "^2.8.0",
    "serve": "^14.2.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "firebase": "^9.6.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
